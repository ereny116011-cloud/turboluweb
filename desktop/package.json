{
  "name": "turboluapp-desktop",
  "productName": "TurboluApp",
  "version": "1.0.0",
  "description": "Turbolu Studios masaüstü uygulaması — sunucu durumu, duyurular, market ve hesap yönetimi.",
  "author": "Turbolu Studios <ereny116011@gmail.com>",
  "license": "GPL-3.0-only",
  "homepage": "https://turboluweb.wasmer.app/",
  "private": true,
  "scripts": {
    "start": "cargo tauri dev",
    "dev": "cargo tauri dev",
    "build": "cargo tauri build",
    "dist": "cargo tauri build",
    "dist:win": "cargo tauri build --bundles nsis",
    "dist:linux": "cargo tauri build --bundles deb,appimage",
    "dist:mac": "cargo tauri build --bundles dmg",
    "icon": "cargo tauri icon src/renderer/asset/logo.png -o src-tauri/icons",
    "checksums": "cargo run --release --example checksums --manifest-path src-tauri/Cargo.toml -- src-tauri/target/release/bundle"
  }
}
